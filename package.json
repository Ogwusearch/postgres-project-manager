{
  "name": "postgres-project-manager",
  "version": "1.0.0",
  "description": "A centralized PostgreSQL management platform for independent projects, databases, environments, migrations, permissions, backups, and recovery.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bash scripts/test-api-smoke.sh",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "db:migrate:control": "node scripts/control-migrations.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
