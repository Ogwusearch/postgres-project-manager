
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Platform control database
PGHOST=127.0.0.1
PGPORT=55433
PGUSER=ppm_registry_app
PGDATABASE=platform_control_db
PGPASSWORD=replace-with-your-app-role-password

# PostgreSQL backup directory
BACKUP_DIR=/var/backups/postgresql

# Trusted target PostgreSQL server
TARGET_PGHOST=127.0.0.1
TARGET_PGPORT=55432
TARGET_PGUSER=
TARGET_PGPASSWORD=
TARGET_PGSSL=disable
TARGET_PG_CONNECT_TIMEOUT_MS=3000
